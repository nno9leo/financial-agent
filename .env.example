SEC_USER_AGENT=
DATA_DIR=data
# Local development only. Compose defaults to this development password; set a private value for local use.
POSTGRES_PASSWORD=
# Local development connection URL. Never use this default for a deployed database.
DATABASE_URL=
# Semantic judge (ADR 0009): OpenRouter API key. Put the real value only in .env (gitignored); never commit or paste it.
OPENROUTER_API_KEY=
